{
  "name": "taskwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:browser": "node scripts/vite.mjs browser dev",
    "build": "node scripts/vite.mjs browser build && node scripts/verify-public.mjs",
    "build:node": "node scripts/vite.mjs file build",
    "preview": "node scripts/vite.mjs browser preview --host 127.0.0.1 --port 5212 --strictPort",
    "ship": "npm run build && wrangler deploy",
    "start": "node scripts/start.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "cf:types": "wrangler types",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "svelte-kit sync"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
