{
  "name": "taskwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5187 --strictPort",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "svelte-kit sync"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
